# Discord Bot Token
TOKEN=your_bot_token_here

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/discordbot

# Lavalink Configuration (Optional - for music)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_AUTH=youshallnotpass
LAVALINK_SECURE=false

# Environment
NODE_ENV=development
LOG_LEVEL=info
